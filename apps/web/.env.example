# The dashboard's settings. Copy to .env.local (git-ignored) and fill in.
# All are server-side: none is NEXT_PUBLIC_, so none reaches the browser.

# Where the dashboard runs. GitHub sends users back to $APP_URL/api/auth/callback,
# which must be one of the App's callback URLs (docs/github-app.md).
APP_URL=http://localhost:3000

# The CodeLens API, and the secret it verifies tokens with: the same value as
# API_JWT_SECRET in the root .env.
API_URL=http://localhost:8000
API_JWT_SECRET=

# Signs the session cookie. Its own secret, at least 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The open, read-only demo (docs/demo.md): no sign-in; the API must run with
# DEMO_MODE=true too. A demo needs only API_URL, API_JWT_SECRET and DEMO_MODE.
# DEMO_MODE=true

# The GitHub App's OAuth client: the same values as in the root .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
