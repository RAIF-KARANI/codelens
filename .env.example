# Copy to .env and adjust. Never commit .env.
#
# URLs here point at localhost, for tools you run on your host machine.
# docker-compose.yml overrides DATABASE_URL / REDIS_URL for containers.

# --- Postgres (used by the postgres container and by compose interpolation)
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens
POSTGRES_PORT=5433

# --- Redis
REDIS_PORT=6379

# --- Application
DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5433/codelens
REDIS_URL=redis://localhost:6379/0
API_PORT=8000
LOG_LEVEL=INFO

# Embedding vector size. Baked into the schema at migration time; must match
# the embedding model you pick in Phase 2. Max 2000 (pgvector HNSW limit).
EMBED_DIM=1024

# --- Model providers (Phase 2). "fake" = deterministic offline stand-ins.
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
# Host-native Ollama. docker-compose.yml overrides this for containers with
# http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
# 8192 fits an 8 GB GPU; 16384 needs OLLAMA_FLASH_ATTENTION=1 + OLLAMA_KV_CACHE_TYPE=q8_0
# set on the Ollama server (planning.md §11.4).
LLM_NUM_CTX=8192
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_BATCH_SIZE=32
# 2048 keeps the embedder small enough to share an 8 GB GPU with the LLM.
EMBED_NUM_CTX=2048
EMBED_QUERY_ON_CPU=false

# --- Pipeline the worker reviews with (relative to the repo root, /app in containers)
PIPELINE_CONFIG=configs/pipeline/default.yaml

# --- API (planning.md §7)
# Signs the dashboard's tokens (HS256); at least 32 bytes. Empty = the API
# refuses every /api/v1 request. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_JWT_SECRET=
# true: the read-only public demo (planning.md §15): no writes or webhooks, no Redis
# needed, and every signed-in user sees every repo (D115).
DEMO_MODE=false
# GitHub logins (comma-separated) that see every repo, including local and eval
# ones; everyone else sees the repos of the App installations they can access.
API_ADMIN_LOGINS=

# --- GitHub App (docs/github-app.md). `python -m core.github register` writes
# these to secrets/github-app.env; copy them here.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=secrets/github-app.pem
# Empty = the webhook endpoint refuses every delivery.
GITHUB_WEBHOOK_SECRET=
# The accounts (comma-separated GitHub logins) whose installations are indexed
# and reviewed; any other installation is ignored (D119). Empty = nobody: list
# yourself. Required before the App's settings allow "Any account".
GITHUB_ALLOWED_ACCOUNTS=
# PR reviews one account may start per hour; more are recorded, not run (D120).
# 0 = no cap.
GITHUB_REVIEWS_PER_HOUR=10

# --- Storage: bare mirrors of GitHub repos go in DATA_DIR/repos/ (gitignored)
DATA_DIR=data
