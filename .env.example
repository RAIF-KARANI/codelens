# Copy to .env and adjust. Never commit .env.
#
# URLs here point at localhost, for tools you run on your host machine.
# docker-compose.yml overrides DATABASE_URL / REDIS_URL for containers.

# --- Postgres (used by the postgres container and by compose interpolation)
POSTGRES_USER=codelens
POSTGRES_PASSWORD=codelens
POSTGRES_DB=codelens
POSTGRES_PORT=5433

# --- Redis
REDIS_PORT=6379

# --- Application
DATABASE_URL=postgresql+asyncpg://codelens:codelens@localhost:5433/codelens
REDIS_URL=redis://localhost:6379/0
API_PORT=8000
LOG_LEVEL=INFO

# Embedding vector size. Baked into the schema at migration time; must match
# the embedding model you pick in Phase 2. Max 2000 (pgvector HNSW limit).
EMBED_DIM=1024

# --- Model providers (Phase 2). "fake" = deterministic offline stand-ins.
LLM_PROVIDER=ollama
EMBED_PROVIDER=ollama
# Host-native Ollama. docker-compose.yml overrides this for containers with
# http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
# 8192 fits an 8 GB GPU; 16384 needs OLLAMA_FLASH_ATTENTION=1 + OLLAMA_KV_CACHE_TYPE=q8_0
# set on the Ollama server (planning.md §11.4).
LLM_NUM_CTX=8192
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_BATCH_SIZE=32
# 2048 keeps the embedder small enough to share an 8 GB GPU with the LLM.
EMBED_NUM_CTX=2048
EMBED_QUERY_ON_CPU=false
